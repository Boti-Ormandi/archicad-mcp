{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)[\\w-]*requirements([-._]\\w+)?\\.(txt|pip)$/",
      "/(^|/)requirements/build\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "automerge": false
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements/build.txt"],
      "automerge": false
    },
    {
      "matchDepNames": [
        "hatch-vcs",
        "hatchling",
        "packaging",
        "pathspec",
        "pluggy",
        "setuptools",
        "setuptools-scm",
        "tomlkit",
        "trove-classifiers",
        "vcs-versioning"
      ],
      "automerge": false
    },
    {
      "matchDepNames": ["python"],
      "enabled": false
    }
  ]
}
